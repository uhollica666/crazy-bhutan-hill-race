# Copy to .env.local (ignored by Git) to override anything below. Every value is optional: the defaults in
# src/cloud/config.ts already point at the project's PUBLIC web configuration.
#
# The Firebase web config is public client configuration, not a secret: it identifies the project, it does not
# authorise anything (Firestore Security Rules and Authentication do that). Never put a service-account key, an
# admin credential or a password in any VITE_ variable: everything prefixed VITE_ is shipped to every browser.

# Set to 0 to build the game with all cloud features switched off (fully offline build).
VITE_CLOUD_ENABLED=1

# Use the local Firebase Emulator Suite (auth on :9099, Firestore on :8080) instead of the real project.
# `bun run dev:emulated` sets this for you.
VITE_USE_EMULATORS=0
VITE_EMULATOR_HOST=127.0.0.1

# Optional overrides of the public web configuration.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# App Check (reCAPTCHA v3 / Enterprise site key). Leave empty until App Check is configured in the Firebase
# Console (see docs/FIREBASE.md). Nothing is invented here: with no key, App Check is not initialised.
# VITE_APPCHECK_SITE_KEY=
