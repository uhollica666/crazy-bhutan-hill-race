{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crazy Bhutan Hill Race",
  "version": "0.4.0-beta.1",
  "identifier": "com.novarah.cbhr",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Crazy Bhutan Hill Race",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Novarah Interactives",
    "shortDescription": "A remastered arcade driving adventure through fictional Bhutan.",
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" }, "wix": { "version": "0.4.0.1" } },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
