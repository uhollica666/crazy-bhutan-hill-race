{
  "name": "crazy-bhutan-hill-race",
  "private": true,
  "version": "0.4.0-beta.1",
  "type": "module",
  "description": "Lightweight stylized 3D arcade driving game set in a fictionalized Bhutan.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "tauri": "bunx --package @tauri-apps/cli@2.12.1 tauri",
    "build:windows": "bun run tauri build --bundles msi,nsis",
    "build:android": "bun run tauri android build --target aarch64 --apk --ci",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "dev:lan": "vite --host",
    "preview:lan": "vite preview --host --port 4173",
    "shots": "node scripts/shots.mjs",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-crazy-bhutan-hill-race \"vitest run --config vitest.emulator.config.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-crazy-bhutan-hill-race",
    "dev:emulated": "vite --mode emulated",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "build:emulated": "tsc --noEmit && vite build --mode emulated --outDir dist-emulated",
    "preview:emulated": "vite preview --outDir dist-emulated --port 4174",
    "test:e2e:cloud": "firebase emulators:exec --only auth,firestore --project demo-crazy-bhutan-hill-race \"playwright test --project=cloud\"",
    "feedback:report": "node scripts/feedback-report.mjs",
    "site:data": "bun scripts/site-data.ts",
    "site:shots": "node scripts/site-shots.mjs screenshots/site candidates"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "firebase-tools": "^15.33.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.3.14"
}
